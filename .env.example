# 复制为 .env 后填写。.env 已被 .gitignore 忽略，永不提交。
#
# 分两类：
#   1) 机密（API key / token）—— 只从环境变量读，config/*.yaml 里绝不出现
#   2) 部署参数（MILVUS_URI / RAG_PROFILE / *_BASE_URL / *_MODEL_NAME）—— 供 config/*.yaml
#      的 ${VAR:-default} 插值。这些不是机密，但同样跟机器和账号有关，所以也放 .env

# ---------- 部署参数 ----------
# 向量库地址。不设则用 config/base.yaml 里的通用默认 http://localhost:19530。
# 本机的实际 Milvus 在虚拟机上，填虚拟机的地址（如 http://192.168.x.x:19530）
MILVUS_URI=http://localhost:19530
# 开工前的探活超时（秒）。Milvus 停掉时 pymilvus 的重连会空转很久
# （实测 `rag ingest` 烧了三十几分钟 CPU、数据一行没进），探活接不住就直接退出。
RAG_MILVUS_PROBE_TIMEOUT_S=5
# 配置档位，决定加载 config/<profile>.yaml（默认 dev）
RAG_PROFILE=dev
# 自建 Milvus 若开了鉴权才需要
# MILVUS_TOKEN=

# OCR 文档解析（PaddleOCR-VL）。对应 config/base.yaml 里 ingest.ocr.base_url。
# 填的是**产线服务**（paddleocr-vl-api）的地址，默认端口 8080 —— 不是 8118，
# 8118 是它下游那个 vLLM 托管的模型，单独打它拿不到版面分析。
# 留空/不设 = 不启用 OCR，扫描件会被跳过并说明原因；纯数字语料不受影响。
# PADDLEOCR_BASE_URL=http://localhost:8080

# dots.ocr 的 vLLM 服务（**PDF 解析的默认后端**，对应 config/base.yaml 的 ingest.dots）。
# 它是 OpenAI 兼容接口（/v1/chat/completions），本地服务不要 key。
# 换机器/换模型只改这两个值；要退回 PaddleOCR 产线就把 RAG_PDF_PARSER 设成 paddleocr。
DOTS_OCR_BASE_URL=http://127.0.0.1:6006
DOTS_OCR_MODEL_NAME=dots_ocr
# 用哪个后端解析 PDF（**工厂按这个名字建对应的 client**）：
#   paddleocr —— PaddleOCR 产线（**规范名**；老名字 `ocr` 仍然认，两个都行）
#   mineru    —— MinerU 远程 API（推荐做定位：middle_json 有逐页逐块 + bbox）
#   dots      —— dots.ocr（给标题层级）
#   pymupdf   —— 本机抽文字层，有损降级（不是 OCR）
RAG_PDF_PARSER=dots

# MinerU 远程 API（对应 config/base.yaml 的 ingest.mineru）。它和 dots.ocr 都用过 6006，
# **谁在跑由部署决定 → RAG_PDF_PARSER 要跟着改**。
MINERU_BASE_URL=http://127.0.0.1:6006
# 本地部署留空；网关/云端才填
MINERU_API_KEY=
# flash | basic | standard（默认，VLM，约 27 秒/页）| advanced
MINERU_TIER=standard
# 只解析这些页（1 起，如 1-5,8；空 = 整份）。大文档靠它控代价
MINERU_PAGE_RANGE=

# 图片本体的落盘目录。图片进 Milvus 的是**描述文本**，本体留在这里（先本地，
# 后续换对象存储改这里即可；正文里的标记只带相对路径，不用跟着改）。
# RAG_ASSETS_DIR=./data/assets

# 本地产线挂掉时的兜底：PaddleOCR **云端 API** 的 access token
#（在 PaddleOCR 的 AI Studio 平台申请）。配了这个，再把 config/base.yaml 里
# ingest.ocr.cloud_fallback.enabled 设成 true 才生效 —— 它按量计费。
PADDLEOCR_ACCESS_TOKEN=
# 云端兜底服务的地址（只有自建 / 换网关时才改；路径固定）
# PADDLEOCR_CLOUD_BASE_URL=https://paddleocr.aistudio-app.com

# ---------- Firecrawl（**云端**网页抓取，可选）----------
# 「从链接导入」默认走本机抓取（`ingest.uploads.fetch.backend=http`）。碰到那些
# **靠 JS 渲染 / 导航很脏**的站点，可以把它切成 firecrawl：正文由 Firecrawl 的
# `/scrape`（onlyMainContent）给，导航与页脚不进来；**图片仍由我们下到本地**，
# 所以多模态那条不受影响。PDF / 图片等**不走 Firecrawl**（那几条路要的是原件）。
#   * 按量计费：切过去是一次显式决定，别在没打算花钱时打开；
#   * 抓取会把 URL 与页面内容交给第三方 —— 内网文档站（allow_private_hosts）那条路
#     云端够不着，两者互斥；
#   * 自建部署再设 FIRECRAWL_API_URL（路径仍是 /v2/scrape）。
FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=https://api.firecrawl.dev
# 网页用谁来抓：http（默认，本机抓、自己抽正文、不花钱）/ firecrawl（云端 /scrape，
# 正文干净得多但按量计费）。**只管网页** —— PDF / 图片 / 附件一律仍走本机。
# RAG_FETCH_BACKEND=http

# agent（deepagents，M5）用哪家 chat 供应商 —— 填 providers.chat 里的**键名**。
# 指向哪家就用哪家的三件套，所以这里只填名字，不填模型。
AGENT_CHAT=default
# agent 能不能把文件写到 data/workspace（批次 B）。true 时写类工具
#（write_file / edit_file / delete / execute）**一律先等人批准**，批准了才落盘；
# false = 退回只读，写只落在内存 state 里。
RAG_AGENT_WRITES=true

# ---------- embedding：两种向量化方式二选一 ----------
# 默认那套是**纯文本**：图片先由 VLM 写成描述，再和正文一样编码（图本身不进向量）。
# 换下面这三个值就是**图+文同一个空间**（qwen3-vl-embedding，线上、按量计费）：
#   EMBEDDING_BACKEND=qwen3-vl
#   EMBEDDING_MODEL=qwen3-vl-embedding
#   EMBEDDING_DIM=2560          # 不改的话第一次调用就报维度不符
# 换过去还要**换 collection 名**（config/dev.yaml 的 indexing.vector.collection）：
# Milvus 建好表就改不了维度。中间产物不用手动清 —— pipeline 指纹里带着 backend/dim，
# 对不上会自动重切重灌。
# EMBEDDING_BACKEND=sentence-transformers
# EMBEDDING_MODEL=.models/Qwen3-Embedding-0.6B
# EMBEDDING_DIM=1024
# 只有 qwen3-vl 用得上：供应商名（决定读哪把 key）与端点（原生接口，不是兼容通道）
# EMBEDDING_PROVIDER=dashscope
# EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding

# ---------- 重排（rerank）与 HuggingFace 下载 ----------
# 检索结果的本地重排开关：false 时按融合名次给结果（做 A/B 对比用，省一次本地推理）。
# RAG_RERANK=true
# 换重排后端：sentence-transformers（默认，CrossEncoder + .models/bge-reranker-base）
# 或 flashrank（ONNX；**只有 flashrank 需要 HF_TOKEN** —— 它下模型时硬编码直连
# huggingface.co、既不带鉴权、用的又是个 404 的旧文件名，所以由我们带 token 去下）。
# RAG_RERANK_BACKEND=sentence-transformers
# 换重排模型（本地路径或 HF id）
# RAG_RERANK_MODEL=.models/bge-reranker-base
# flashrank 的模型缓存目录（它默认写 /tmp，重启就没了，所以指到项目内）
# RAG_RERANK_CACHE=.models/flashrank
# HuggingFace **镜像**：huggingface.co 直连不通，默认走 hf-mirror.com。
# 能直连的机器上设成 https://huggingface.co 即可（两个模型的下载都看这个值）。
# HF_ENDPOINT=https://hf-mirror.com
# HuggingFace token（只有 flashrank 那条路要，见上）
# HF_TOKEN=

# ---------- chat 供应商：每家三件套 ----------
# 每家配 key + base_url + model_name 三件套，对应 config/base.yaml 里 providers.chat.<名字>。
# 换供应商 / 换网关 / 换模型 = 只改这里，不用动要提交的配置。
#   * 走 OpenAI 兼容通道的（deepseek / dashscope / zhipuai / moonshot）BASE_URL 必填，
#     缺失会直接报错（而不是悄悄发往别处或等远端超时）；
#   * 原生集成的（openai）BASE_URL 留空即用官方地址，填了则走网关。
#   * MODEL_NAME 必须填成账号下真实存在的模型名 —— 写错要到第一次 rag ask 才以远端 400
#     暴露，那时不容易联想到是配置写错了。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.ztoken.pro/v1/
OPENAI_MODEL_NAME=gpt-5.6-luna

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_NAME=qwen3.8-flash

# 看图说话的模型（VLM）：图片描述用它（config/base.yaml 的 providers.vision）。
# **与上面 chat 那套是两套模型** —— qwen-plus 认识字、不认识图。
# API_KEY 留空则回退到 DASHSCOPE_API_KEY（同一个账号同一把 key）；
# BASE_URL 只有换网关时才需要改，MODEL_NAME 必须填账号下真实存在、且能看图的模型。
DASHSCOPE_VL_API_KEY=
DASHSCOPE_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VL_MODEL_NAME=qwen-vl-max

# 语音转文字（ASR）：对话页输入框那个麦克风（config/base.yaml 的 providers.asr）。
# **qwen-vl-max 干不了这件事** —— 它看图，不看音频；语音在 DashScope 是另一族模型。
# 默认型号是查过账号里 `GET /compatible-mode/v1/models` 的清单才写的。
#
# ⚠️ **BASE_URL 是根域**，不是 compatible-mode：ASR 走的是 DashScope **原生**端点
#   /api/v1/services/aigc/multimodal-generation/generation
# （vision 才是 OpenAI 兼容的那条）。填错会在第一次调用时报 format is empty。
# 账号若走百炼工作空间域名，就填 https://<workspace-id>.cn-beijing.maas.aliyuncs.com
# API_KEY 留空回退到 DASHSCOPE_API_KEY（同一个账号同一把 key）。
DASHSCOPE_ASR_API_KEY=
DASHSCOPE_ASR_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_ASR_MODEL_NAME=qwen-audio-3.0-asr-flash

ZHIPUAI_API_KEY=
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPUAI_MODEL_NAME=glm-4-flash

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL_NAME=kimi-k2.6

# ---------- 观测 / 外部检索 ----------
# ---------- 数据库（统一开关，2026-10-10 加）----------
# ---------- 部署档位 ----------
# local-lite：Milvus Lite + SQLite + local storage，单 worker，无需 Docker；
# docker-single：Docker Milvus + 同实例 MinIO 独立 bucket + SQLite，单 worker；
# multiworker：Docker Milvus + PostgreSQL + MinIO + Redis，workers >= 2。
RAG_DEPLOYMENT_PROFILE=local-lite
# 三档本地状态根：<RAG_STATE_ROOT>/<profile>/
RAG_STATE_ROOT=./data
RAG_COLLECTION_LOCAL_LITE=rag_local_lite_v1
RAG_COLLECTION_DOCKER_SINGLE=rag_docker_single_v1
RAG_COLLECTION_MULTIWORKER=rag_multiworker_v1
MINIO_BUCKET_DOCKER_SINGLE=rag-docker-single
MINIO_BUCKET_MULTIWORKER=rag-multiworker
MINIO_BUCKET_MILVUS_INTERNAL=milvus-bucket
RAG_PG_SCHEMA_MULTIWORKER=rag_multiworker
RAG_REDIS_PREFIX_MULTIWORKER=rag:multiworker:
# 外部容器/进程副本数；两个单 worker 容器时设 2
RAG_DEPLOYMENT_REPLICAS=1
# 灌库槽位租约（秒）：持有者崩溃后多久自动回收
RAG_INGEST_LEASE_S=86400

# 关系型数据落哪个库，**一个开关管三份**：文档注册表 + 上传件台账、模型选型、日志索引。
#   （留空/auto —— 配了 RAG_PG_URL 就用 pg，否则单机 sqlite；与从前一致）
#   pg / sqlite —— 显式指定（写 postgres 也行；选 pg 却没配 RAG_PG_URL 会当场报错）
# 注意：LangGraph 的**会话状态 / HITL 中断**不跟这个开关，它只有 PG 一个实现（由
#   RAG_PG_URL 决定）；要彻底单机就把 RAG_PG_URL 也清掉，那样它退回进程内、重启即丢。
# 某一类想单独指定：yaml 里 documents.backend / models.backend（留 auto = 听这个开关）。
# RAG_DB_BACKEND=auto
# PostgreSQL：**留空 = 单机 SQLite**（默认那条路什么都不用配）。多 worker / 多机才填。
# url 不带密码（密码单独一个变量，更不容易被日志带出去）；schema 隔离靠连接串里的
# options=-c search_path=<schema>，库只建表不建 schema。
# schema / 连接池 / 超时的默认值就是下面这几个，按需调。
# RAG_PG_URL=postgresql://rag@127.0.0.1:5432/rag
# RAG_PG_PASSWORD=
# RAG_PG_SCHEMA=rag
# RAG_PG_POOL_MIN=1
# RAG_PG_POOL_MAX=5
# RAG_PG_TIMEOUT_S=10

# ---------- 文件后端（统一开关，2026-10-10 加）----------
# 文件落本地盘还是进 MinIO 桶，**一个开关管四个域**：上传件、中间产物、原始资产、会话图片。
#   （local —— 本地盘，默认；单机不装 MinIO 也能跑，行为与从前逐字节一致）
#   minio —— 进桶（S3 兼容）：多 worker 下 worker A 上传的文件 worker B 读得到。
# 那四个域在 yaml 里默认写 auto = 听这里；想把某一个域单独钉死（比如产物进桶、上传件留本地盘），
#   改 yaml 里 ingest.uploads.backend / ingest.stages.backend / ingest.assets.backend / api.media_backend
#   （写 local / minio；留 auto = 跟这个开关）。
# 地址与桶名在 config/base.yaml（非机密）；选了 minio 就必须在下面填这两把 key，缺了当场报错。
# RAG_STORAGE_BACKEND=local
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=

# ---------- 主密钥（页面能填 API key 的前提）----------
# 设置页/接口收上来的供应商 key 要**加密存库**（AES-256-GCM），主密钥就是它。
#   * 不配：页面直接禁填 key（仍可改 base_url），**不是**报错；
#   * 配了：库里只存密文，页面与接口永不回显（只回 has_key + sha256 前 8 位指纹）；
#   * 换掉它 = 已存进库的那些 key 全部解不开，得重填。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
# RAG_SECRET_KEY=

# ---------- API 服务（`rag serve`，M4）----------
# 访问令牌：客户端带 X-API-Key 头。**留空则只允许 127.0.0.1**（否则等于裸奔）。
RAG_API_KEY=
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
RAG_API_WORKERS=1
# Vite web 开发服务器监听地址；0.0.0.0 可供局域网访问
RAG_WEB_HOST=127.0.0.1
RAG_WEB_PORT=5174
# 每分钟每个 key/IP 的请求上限（0 = 不限）
RAG_API_RATE_LIMIT=60

# ---------- Redis（限流计数 + 任务状态，走 SSH 隧道）----------
# **留空 = 退回进程内实现**（限流各 worker 各算、任务状态只在内存里）。
# 隧道本地地址，例如 redis://127.0.0.1:6379/0；密码单独一个变量（更不容易被日志带出去）
RAG_REDIS_URL=
RAG_REDIS_PASSWORD=
# 键前缀：这台 Redis 上可能还有别人的键，我们只用 <前缀>rate:* 与 <前缀>job:*
RAG_REDIS_KEY_PREFIX=rag:
# 操作与探活超时（秒）：Redis 慢不该拖垮 API，超时按「不可用」处理
RAG_REDIS_TIMEOUT_S=2

# ---------- Neo4j（知识图谱，M6；同样走 SSH 隧道）----------
# bolt 地址。隧道示例：ssh -L 7687:127.0.0.1:7687 <用户>@<机器>
NEO4J_URI=bolt://127.0.0.1:7687
# 用户名在 yaml（非机密），密码只放这里
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# LangSmith trace（调 agent 行为用，M6）
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
# 日志内容（问题 / 答案 / 查询原文）默认不落 —— 里面有语料与用户原话。排查时临时开。
# **工具调用那一行不受这个开关管**：agent_tool 的入参/出参永远给内容、只截断（上限见
# src/rag/obs/log.py 的 TOOL_*_CHARS）—— 只报「输入多少字 / 输出多少字」等于没给。
RAG_LOG_CONTENT=false
# 每一行日志顺手再写一份进 PG（`log_line` 表，与 chat 三张表同库）：日志页按
# request_id / 类别 / 时间查、以及点行里那个 req-… 都靠它。**文件仍是唯一真相**，
# 写库失败只喊一句、不拖业务。表要先用 `rag logs init` 建。
# 填 false 或没配 RAG_PG_URL = 只落文件（页面「刷新」那条路照常）。
RAG_LOG_PG=true
# web 搜索通道：走**智谱的 web 搜索**，复用上面的 ZHIPUAI_API_KEY，不额外要 key。
# 抓取工具由使用者自研，本项目只留通道位置，尚未落地。

# ---------- 可选：路径与逐域覆盖（单机一个字都不用改）----------
# 下面这些都能用环境变量覆盖 config/base.yaml 里的同名项；默认值就写在注释里。
# 落盘路径（换盘 / 换机器时用；都是相对仓库根目录）
# RAG_UPLOADS_DIR=./data/uploads
# RAG_STAGES_DIR=./data/stages
# RAG_ASSETS_DIR=./data/assets
# RAG_BLOB_CACHE=./data/cache/blobs
# RAG_VISION_CACHE=./data/cache/image_descriptions.json
# auto（听 RAG_STORAGE_BACKEND）| local | minio；multiworker 下强制用桶
# RAG_VISION_CACHE_BACKEND=auto
# MinIO 的地址与桶名（非机密，写在 config/base.yaml 也行，那个是默认值）
# MINIO_ENDPOINT=localhost:9000
# 逐域覆盖文件后端：auto（默认，听 RAG_STORAGE_BACKEND）| local | minio
# UPLOADS_BACKEND=auto
# STAGES_BACKEND=auto
# ASSETS_BACKEND=auto
# MEDIA_BACKEND=auto
# 知识图谱通道（M6，默认关；开了要有 Neo4j，见下面的 NEO4J_*）
# RAG_GRAPH=false

# 启动脚本（scripts/start.*）用哪个解释器跑后端。留空则依次尝试：rag → python（能 import rag 的）→ conda 各环境。
RAG_PYTHON=
